/var/log/apache2/access_log {
    compress
    dateext
    maxage 365
    rotate 365
    size=+4096k
    notifempty
    missingok
    create 644 root root
    postrotate
     /etc/init.d/apache2 reload
     /usr/local/bin/move_old_httpd_logs.sh
    endscript
}

