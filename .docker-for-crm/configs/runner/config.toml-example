concurrent = 1
check_interval = 0
connection_max_age = "15m0s"
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "Runner-for-crm-php-docker"
  url = "https://gitlabs.hoststar.ch"
  id = RUNNER_ID
  token = "RUNNER_TOKEN"
  token_obtained_at = 2025-09-25T08:18:08Z
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "shell"
  builds_dir = "/home/gitlab-runner/build"
  [runners.custom_build_dir]
    enabled = true

[[runners]]
  name = "Runner for crm-php-docker (docker-build)"
  url = "https://gitlabs.hoststar.ch"
  id = 37
  token = "glrt-dQl7VRBg6g9e08l_A1rrJm86MQpwOjMyCnQ6Mwp1OmsQ.01.18133xjjh"
  token_obtained_at = 2025-09-26T10:58:58Z
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "docker"
  [runners.cache]
    MaxUploadedArchiveSize = 0
    [runners.cache.s3]
    [runners.cache.gcs]
    [runners.cache.azure]
  [runners.docker]
    tls_verify = false
    image = "docker:stable"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = ["/cache"]
    shm_size = 0
    network_mtu = 0
