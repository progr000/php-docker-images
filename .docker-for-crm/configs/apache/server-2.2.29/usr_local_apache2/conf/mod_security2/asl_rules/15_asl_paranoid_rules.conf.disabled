############ COMMAND INJECTION RULES #########################
SecRule REQUEST_URI|REQUEST_COOKIES|ARGS|!ARGS:title "@pm cmd cd ls pwd perl echo uname curl kill echo sh cpp python chown rm ping rsync rdiff-backup ssh scp wget links g++ chgrp chown passwd bash telnet  \# \| \; \`" \
"phase:2,id:333807,t:none,t:urlDecodeUni,pass,nolog,skip:1"
