#---ASL-CONFIG-FILE---
#

# Do not edit this file!
# This file is generated and changes will be overwritten.
#
# If you need to make changes to the rules, please follow the procedure here:
# http://www.atomicorp.com/wiki/index.php/Mod_security

SecRule TX:ATOMIC_PARANOID_MODE "!@eq 1" "phase:2,id:'303000',t:none,nolog,pass,skipAfter:END_PARANOID"

SecRule REQUEST_HEADERS:Range "^bytes=(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\,(\d+)?\-(\d+)?\," \
 "phase:2,capture,rev:2,t:none,t:lowercase,deny,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Range: Too many fields, this may be a DOS attack',logdata:'%{matched_var}',severity:'5',id:343013"

SecRule &REQUEST_HEADERS:Content-Type "@eq 0" \
    "chain,phase:2,rev:5,t:none,deny,status:403,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Request Containing Content, but Missing Content-Type header',id:'392301',severity:'5'"
        SecRule REQUEST_HEADERS:Content-Length "!^0$" "t:none,ctl:forceRequestBodyVariable=On"

SecRule &ARGS "@gt 1000"  \
"phase:2,t:none,log,auditlog,deny,status:403,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Too many arguments in request (max set to 1000, increase as necessary for your system)',id:'390707',severity:'4',rev:4"

SecRule ARGS|ARGS_NAMES "@validateByteRange 1-255" \
        "deny,status:403,phase:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Invalid character in ARGS',rev:9,id:'390614',severity:'2',t:none,t:urlDecodeUni"

SecRule REQUEST_FILENAME|ARGS|ARGS_NAMES "(?:\.cookie\b.*?;\W*?(?:expires|domain)\W*?=|\bhttp-equiv\W+set-cookie\b)" \
        "phase:2,t:none,t:htmlEntityDecode,t:compressWhiteSpace,t:lowercase,capture,ctl:auditLogParts=+E,deny,log,auditlog,status:501,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Session Fixation Attack',id:'390708',rev:5,logdata:'%{TX.0}',severity:'2'"


#Rule 340007: generic recursion signatures
SecRule REQUEST_URI|ARGS "(?:\x5c|(?:%(?:c(?:0%(?:9v|af)|1%1c)|2(?:5(?:2f|5c)|f)|u221[56]|1u|5c)|\/))(?:%(?:u2024|2e)|\.){2}(?:\x5c|(?:%(?:c(?:0%(?:9v|af)|1%1c)|2(?:5(?:2f|5c)|f)|u221[56]|1u|5c)|\/))"  \
        "deny,status:403,t:none,t:lowercase,capture,id:340007,rev:39,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic Path Recursion denied',logdata:'%{TX.0}'"

SecRule REQUEST_URI|REQUEST_HEADERS|ARGS "\.\./\.\."  \
        "deny,status:403,t:none,t:urlDecodeUni,t:normalisePath,capture,id:340006,rev:54,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: Generic Path Recursion denied in URI/ARGS',logdata:'%{TX.0}'"

SecRule REQUEST_URI|ARGS "@streq ../../../../.." \
        "phase:2,deny,status:403,t:none,t:urlDecodeUni,t:normalisePath,id:347008,rev:12,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Suspicious deep path recursion denied'"


# Rule 340008: generic bogus path sigs
SecRule REQUEST_URI|REQUEST_HEADERS|ARGS "/\.{3,}/" \
        "phase:2,deny,status:403,t:none,t:urlDecodeUni,t:replaceNulls,t:normalisePath,id:340008,rev:7,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Bogus Path denied'"

# Rule 340009: generic recursion signatures
SecRule REQUEST_HEADERS|REQUEST_FILENAME|!REQUEST_HEADERS:X-PageView|!REQUEST_HEADERS:Cookie|!REQUEST_HEADERS:REFERER|ARGS "(?:( |\.\.)/(?:etc|proc|var/tmp|usr|opt|s?bin|dev|tmp|kern|[br]oot|sys|windows|winnt)/|(?:\/|\\\\)+inetpub|localstart\.asp|boot\.ini)" \
        "phase:2,deny,status:403,t:none,t:urlDecodeUni,t:replaceNulls,t:normalisePath,t:compressWhitespace,t:lowercase,capture,id:340009,rev:56,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Protected Path Access denied in URI/ARGS',logdata:'%{TX.0}'"


#Protected file upload protection
SecRule REQUEST_FILENAME|ARGS|ARGS_NAMES|REQUEST_HEADERS|XML:/* "@pm .www_acl .htpasswd .htaccess boot.ini httpd.conf /etc/ .htgroup global.asa .wwwacl .history .bash_history" \
"phase:2,id:'333796',t:none,t:urlDecodeUni,t:htmlEntityDecode,pass,nolog,skip:1"
SecAction phase:2,id:334362,t:none,pass,nolog,skipAfter:END_FILE_PROTECTION_2

SecRule REQUEST_FILENAME|ARGS|ARGS_NAMES "(?:\b(?:\.(?:ht(?:access|passwd|group)|www_?acl)|global\.asa|httpd\.conf|boot\.ini)\b|( |^|\.\.)/etc/|/\.(?:history|bash_history|sh_history)$)" \
"phase:2,deny,status:403,capture,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:compressWhitespace,t:lowercase,ctl:auditLogParts=+E,deny,log,auditlog,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Attempt to Access protect file Remotely',id:'390709',rev:24,logdata:'%{TX.0}',severity:'2'"


SecRule REQUEST_HEADERS|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie "(?:\b(?:\.(?:ht(?:access|passwd|group)|www_?acl)|global\.asa|httpd\.conf|boot\.ini)\b|\/etc\/|/\.(?:history|bash_history|sh_history)$)" \
"phase:2,deny,status:403,capture,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:compressWhitespace,t:lowercase,ctl:auditLogParts=+E,deny,log,auditlog,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Attempt to Access protect file Remotely',id:'390719',rev:6,logdata:'%{TX.0}',severity:'2'


SecMarker END_FILE_PROTECTION_1

#Protected file upload protection
SecRule REQUEST_FILENAME|ARGS|ARGS_NAMES|REQUEST_HEADERS|XML:/* "@pm .www_acl .htpasswd .htaccess boot.ini httpd.conf /etc/ .htgroup global.asa .wwwacl .history .bash_history" \
"phase:2,id:'333796',t:none,t:urlDecodeUni,t:htmlEntityDecode,pass,nolog,skip:1"
SecAction phase:2,id:334362,t:none,pass,nolog,skipAfter:END_FILE_PROTECTION_2

SecRule REQUEST_FILENAME|ARGS|ARGS_NAMES "(?:\b(?:\.(?:ht(?:access|passwd|group)|www_?acl)|global\.asa|httpd\.conf|boot\.ini)\b|( |^|\.\.)/etc/|/\.(?:history|bash_history|sh_history)$)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:compressWhitespace,t:lowercase,ctl:auditLogParts=+E,block,log,auditlog,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Attempt to Access protect file Remotely',id:'390709',rev:23,logdata:'%{TX.0}',severity:'2'"


SecRule REQUEST_HEADERS|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie "(?:\b(?:\.(?:ht(?:access|passwd|group)|www_?acl)|global\.asa|httpd\.conf|boot\.ini)\b|\/etc\/|/\.(?:history|bash_history|sh_history)$)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:compressWhitespace,t:lowercase,ctl:auditLogParts=+E,block,log,auditlog,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Attempt to Access protect file Remotely',id:'390719',rev:6,logdata:'%{TX.0}',severity:'2'"
#
SecMarker END_FILE_PROTECTION_2


################ SQL injection rules #########################
#Always SQL injection cases w/ antievasion
SecRule REQUEST_FILENAME "\.(?:(?:m|j)pe?g4?|flv|bmp|tiff?|p(?:(?:p|g|b)m|n(?:g|m)|df)|gif|js|css|ico|avi|w(?:m(?:v|a)|ebp)|mp(?:3|4)|cgm|svg|swf|og(?:m|v|x)|xls|doc|od(?:t|s)|ppt|wbk)$" phase:2,pass,id:'333797',t:none,t:lowercase,nolog,skipAfter:END_SQL_CHECKS

SecRule ARGS|REQUEST_HEADERS|XML:/*|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|REQUEST_COOKIES|REQUEST_COOKIES_NAMES "@pmFromFile sql.txt"  \
        "phase:2,block,status:403,capture,id:340155,t:none,t:urlDecodeUni,t:replaceComments,t:compressWhiteSpace,rev:21,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL Injection protection',logdata:'%{TX.0}'"

#Always SQL injection cases w/ antievasion
SecRule ARGS|ARGS_NAMES|REQUEST_HEADERS|XML:/*|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|REQUEST_COOKIES|REQUEST_COOKIES_NAMES "@pmFromFile sql.txt" \
        "phase:2,block,status:403,capture,id:380023,t:none,t:base64Decode,t:replaceNulls,t:replaceComments,t:compressWhiteSpace,rev:8,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL Injection protection',logdata:'%{TX.0}'"

#Always SQL injection cases w/ antievasion
SecRule ARGS|REQUEST_HEADERS|XML:/*|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|REQUEST_COOKIES|REQUEST_COOKIES_NAMES "@pmFromFile sql.txt"  \
        "phase:2,block,status:403,capture,id:380024,t:none,t:hexDecode,t:replaceNulls,t:replaceComments,t:compressWhiteSpace,rev:5,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL Injection protection',logdata:'%{TX.0}'"


SecMarker END_SQL_CHECKS

####################################
#First major set
SecRule REQUEST_URI|REQUEST_COOKIES|REQUEST_HEADERS|ARGS|XML:/* "@pm select having grant delete insert drop alter replace truncate update create rename describe table database dba index into from convert bulk column procedure update set union or = ' -- procedure declare exec passthru outfile =1 null =2 =3 <=> <> != eval system exec" \
"phase:2,id:'333799',t:none,t:urlDecodeUni,pass,nolog,skip:1"
SecAction phase:2,id:334363,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_1

#SQL stored procedure injection
SecRule REQUEST_URI|REQUEST_HEADERS|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|XML:/*|ARGS "(?:procedure\s+analyse\s*\(|create\s+(procedure|function)\s*\w+\s*\(\s*\)\s*-|declare[^\w]+[@#]\s*\w+|exec\s*\(\s*@)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:replaceComments,t:compressWhiteSpace,t:lowercase,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE MySQL and PostgreSQL stored procedure/function injections',id:380122,rev:4,logdata:'%{TX.0}',severity:'2'"

#PHP shell code SQL injection
SecRule REQUEST_URI|REQUEST_HEADERS|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|XML:/*|ARGS "(?:union select.*php.*(?:passthru|system|eval|preg_replace|exec|shell_exec ?(?:\(|\: ?'?))|select.*(?:php|perl).*into outfile)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:replaceComments,t:compressWhiteSpace,t:lowercase,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE SQL injection with PHP/PERL payload',id:380025,rev:5,logdata:'%{TX.0}',severity:'2'"


# Rule 340013: 
#Prevent SQL injection in cookies
SecRule REQUEST_COOKIES|REQUEST_HEADERS:User-Agent "(?:(?:select|grant|delete|insert|drop|alter|replace|truncate|update|create|rename|describe)[[:space:]]+[a-z|0-9|\*| |\,]+[[:space:]]+(?:from|into|table|database|index|view)[[:space:]]+[a-z|0-9|\*| |\,]|union select [a-z0-9]|select (?:load_file|char\()|(?:insert|remark)test;)" \
	"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:lowercase,t:replaceNulls,t:replaceComments,t:compressWhiteSpace,id:340013,rev:3,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL injection in cookie or UA',logdata:'%{TX.0}'"

# Rule 340016: 
SecRule REQUEST_URI|REQUEST_HEADERS|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|ARGS|XML:/* "(?:(?:select|grant|delete|insert|drop|alter|replace|truncate|update|create|rename|describe)[[:space:]]+[a-z|0-9|\*|\,]+[[:space:]]+(?:from|into|table|database|index|view)[[:space:]]+[a-z|0-9|\*| |\,]|union select.*[a-z0-9].*into.*from|select (?:load_file|char\()|(?:insert|remark)test;)" \
	"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:lowercase,t:replaceNulls,t:replaceComments,t:compressWhiteSpace,id:340016,rev:24,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL injection protection',logdata:'%{TX.0}'"

#bypass for these, no args
SecRule REQUEST_FILENAME "\.(?:(?:m|j)pe?g4?|bmp|tiff?|p(?:(?:p|g|b)m|n(?:g|m)|df)|gif|js|css|ico|avi|flv|w(?:m(?:v|a)|ebp)|mp(?:3|4)|cgm|svg|swf|og(?:m|v|x)|doc|xls|od(?:t|s)|ppt|wbk)$" phase:2,id:'333800',pass,t:none,t:lowercase,nolog,skipAfter:END_SQL_CHECKS_2

# Rule 340017: 
SecRule REQUEST_URI|REQUEST_HEADERS|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|ARGS "(?:insert into values|select from [a-z|0-9]!( and)|bulk insert|union select|union all select|convert \(.*from|select (?:load_file|char\()|(?:insert|remark)test;)"  \
	"phase:2,block,status:403,capture,t:none,t:lowercase,t:replaceComments,t:compressWhiteSpace,id:340017,rev:48,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL injection protection in ARGS',logdata:'%{TX.0}'"

# Rule 340144: Generic SQL sigs 
SecRule REQUEST_HEADERS|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|ARGS "(?:(?:alter|create|drop)[[:space:]]*(?:column|database|procedure|table) |delete[[:space:]]*update.+set.+=|union all select |union select [a-z][0-9]+ |select (?:load_file|char ?\()|(?:insert|remark)test;)"   \
	"phase:2,block,status:403,capture,id:340144,rev:34,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL injection protection 2',logdata:'%{TX.0}',t:none,t:urlDecodeUni,t:lowercase,t:replaceComments,t:compressWhiteSpace"

SecMarker END_SQL_CHECKS_2

# Rule 340145: Generic SQL sigs
SecRule REQUEST_URI|ARGS|XML:/*|ARGS "(?:or.+1[[:space:]]*=[[:space:]]1|or [0-9] ?= ?[0-9]|admin'(?: --| #)|or ('|\")? ?(0|1|2|3|a|b) ?('|\")? ?= ?('|\")? ?(0|1|2|3|a|b) ?('|\")?|having 1 ?= ?1 ?--|null is null ?--| \b(\d+) ?(?:=|<>|<=>|!=) ?[0-3]\b)" \
	"phase:2,block,status:403,t:none,t:urlDecodeUni,t:replaceComments,t:replaceNulls,t:compressWhitespace,t:lowercase,capture,id:340145,rev:40,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Possible SQL injection probe',logdata:'%{TX.0}'"

# Rule 390572: Generic SQL sigs
SecRule ARGS|XML:/* "(?:or.+1[[:space:]]*=[[:space:]]1|or 1=[0-9]|admin'(?: --| #)| or '1'='1--|having 1 ?= ?1 --|or\+1=[0-9]|null is null ?--|\b(\d+) ?(?:=|<>|<=>|!=) ?[1-3]\b)" \
	"phase:2,block,status:403,t:none,t:urlDecodeUni,t:lowercase,t:replaceNulls,t:compressWhitespace,capture,id:390572,rev:20,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Possible SQL injection probe',logdata:'%{TX.0}'"

# Rule 340146: Meta character SQL injection
SecRule REQUEST_URI "(?:insert[[:space:]]+into.+values|select (\*|[a-z0-9]+) from.+[a-z|0-9]|select.+from|bulk[[:space:]]+insert|union.+select|select (?:load_file|char\()|convert ?\(from|and.*char\(|(?:insert|remark)test ?;)" \
	 "phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:replaceComments,t:compressWhiteSpace,t:replaceNulls,t:lowercase,id:340146,rev:8,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL metacharacter URI injection protection',logdata:'%{TX.0}'"


SecMarker END_SQL_INJECTION_RULE_1

####################### Second Set
#

SecRule REQUEST_FILENAME "\.(?:(?:m|j)pe?g4?|bmp|tiff?|p(?:(?:p|g|b)m|n(?:g|m)|df)|gif|js|css|ico|avi|flv|w(?:m(?:v|a)|ebp)|mp(?:3|4)|cgm|svg|swf|og(?:m|v|x)|doc|xls|od(?:t|s)|ppt|wbk)$" phase:2,id:333801,pass,t:none,t:lowercase,nolog,skipAfter:END_SQL_CHECKS_3

SecRule REQUEST_URI|XML:/*|ARGS|REQUEST_HEADERS "@pm select outfile exec passthru preg_replace eval union concat" \
"phase:2,id:333802,t:none,t:urlDecodeUni,t:base64Decode,t:replaceComments,t:compressWhiteSpace,multimatch,pass,nolog,skip:1"
SecAction phase:2,id:333701,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_2

#PHP shell code SQL injection
SecRule REQUEST_URI|XML:/*|ARGS|REQUEST_HEADERS|REQUEST_COOKIES|REQUEST_COOKIES_NAMES "(?:(?:union select.*php.*(?:system|eval ?\(|shell_exec|passthru|preg_replace|exec).*into)|select.*(?:php|perl).*into outfile|union select all|concat ?\(user_)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:base64Decode,t:replaceComments,t:compressWhiteSpace,t:lowercase,multimatch,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE SQL injection with payload - base64 encoded',id:381025,rev:3,logdata:'%{TX.0}',severity:'2'"
SecMarker END_SQL_INJECTION_RULE_2

SecRule REQUEST_URI|XML:/*|ARGS "@pm select outfile exec passthru" \
"phase:2,id:333803,t:none,t:urlDecodeUni,t:hexDecode,t:replaceComments,t:compressWhiteSpace,pass,nolog,skip:1"
SecAction phase:2,id:334364,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_3

#PHP shell code SQL injection
SecRule REQUEST_URI|XML:/*|ARGS "(?:(?:union select.*php.*(?:system|eval ?\(|shell_exec|preg_replace|passthru|exec).*into)|select.*(?:php|perl).*into outfile)" \
"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:hexDecode,t:replaceComments,t:compressWhiteSpace,t:lowercase,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE SQL injection with PHP/PERL payload - hex encoded',id:381026,rev:2,logdata:'%{TX.0}',severity:'2'"
SecMarker END_SQL_INJECTION_RULE_3

#SQL inline command attack with more AE cases
SecRule ARGS|XML:/* "@pm char execute convert delete insert select drop create table declare null accesslevel user_name concat( union case xecresultset ;set @" \
"phase:2,id:333804,t:none,t:base64Decode,t:hexDecode,t:replaceNulls,t:urlDecodeUni,t:compressWhiteSpace,t:replaceComments,t:compressWhiteSpace,multiMatch,pass,nolog,skip:1"
SecAction phase:2,id:334365,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_4

SecRule ARGS|XML:/*  "(?:(\w+)(?:user|and)(\w+)char\([0-9]+\)|(?:execute|convert)\(|; ?delete.*;(?:insert|declare|varchar) ?|and .* \( ?select .* from |(?:drop|create)(\w+)table |(?:declare|convert) .* varchar\(|null ?, ?(?:null ?, ?(?:null|accesslevel|user_name)) ?,|concat\(|union select |union all select|\b\W*?cast\b\W*?\(|xecresultset|' ?; ?declare\b\W*?|; ?set @|select (?:load_file|char\()|(?:insert|remark)test;)" \
                "phase:2,block,status:403,capture,id:340159,t:none,t:urlDecodeUni,t:base64Decode,t:hexDecode,t:replaceNulls,t:replaceComments,t:compressWhiteSpace,t:lowercase,rev:35,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL inline command protection (MM)',logdata:'%{TX.0}',multiMatch"

SecMarker END_SQL_INJECTION_RULE_4

SecRule  REQUEST_HEADERS|XML:/*|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|!REQUEST_COOKIES_NAMES:/utm/|REQUEST_URI|ARGS|ARGS_NAMES "@pm cast xecresults declare" \
"phase:2,id:333805,t:none,t:replaceComments,t:compressWhiteSpace,t:lowercase,pass,nolog,skip:1"
SecAction phase:2,id:334366,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_5

#SQL Injection cases
SecRule REQUEST_HEADERS|XML:/*|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|!REQUEST_COOKIES_NAMES:/utm/|REQUEST_URI|ARGS|ARGS_NAMES "(?:\b\W*?cast\b\W*?\(|xecresultset|; ?declare\b\W*?)" \
         "phase:2,block,status:403,capture,id:340164,t:none,t:replaceComments,t:compressWhiteSpace,t:lowercase,rev:10,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE SQL Injection Attack',logdata:'%{TX.0}'"
SecMarker END_SQL_INJECTION_RULE_5

SecRule ARGS|REQUEST_URI|XML:/*|REQUEST_HEADERS|ARGS_NAMES "@pm = char( varchar execute convert delete insert declare select drop create table convert( null accesslevel user_name concat( union cast xecresultset declare" \
"phase:2,id:333806,t:none,t:replaceComments,t:compressWhiteSpace,pass,nolog,skip:1"
SecAction phase:2,id:334367,t:none,pass,nolog,skipAfter:END_SQL_INJECTION_RULE_6
#Always bad SQL injection case w/ antievasion
#SecRule ARGS|!ARGS:/^fulltext/|!ARGS:message|ARGS_NAMES|REQUEST_FILENAME|REQUEST_HEADERS|XML:/*|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie|!ARGS:topicseen|!ARGS_NAMES:posted_data[product_substring]|!REQUEST_HEADERS:X-PageView "\b(\d+) ?= ?\1\b|[\'\"](\w+)[\'\"] ?= ?[\'\"]\2\b" \
SecRule ARGS|ARGS_NAMES|REQUEST_HEADERS|XML:/*|!REQUEST_HEADERS:Referer|!REQUEST_HEADERS:Cookie "\b(\d+) ?= ?\1\b|[\'\"](\w+)[\'\"] ?= ?[\'\"]\2\b" \
	"phase:2,block,status:403,capture,id:340156,capture,t:none,t:htmlEntityDecode,t:urlDecodeUni,t:replaceComments,t:compressWhiteSpace,t:lowercase,rev:14,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL injection protection',logdata:'%{TX.0}',logdata:'%{TX.0}'"

#SQL inline command attack
SecRule REQUEST_URI|REQUEST_HEADERS|XML:/*|ARGS  "(?:(\w+)(?:user|and)(\w+)char ?\([0-9]+\)|(?:execute|convert) ?\(|; ?delete.*; ?(?:insert|declare|varchar) ?|and .* \(select |(?:drop|create)(\w+)table |(?:declare|convert) .* varchar\(|null ?, ?null ?, ?(accesslevel|user_?name) ?,|concat\(|union select |union all select|\b\W*?cast\b\W*?\(|xecresultset|' ?; ?declare\b\W*?|; ?set @|select (?:load_file|char ?\()|(?:insert|remark)test;)" \
	"phase:2,block,status:403,capture,id:340157,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:replaceComments,t:compressWhiteSpace,t:lowercase,rev:35,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic SQL inline command protection',logdata:'%{TX.0}'"

