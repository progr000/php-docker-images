#Prevent command injection through cookies
SecRule REQUEST_URI|REQUEST_COOKIES|ARGS "(?:; ?curl |(?:&|;) ?(?:cmd|command) ?= ?(?:chdir|mkdir|rm) |cd /(?:tmp|/var/tmp|/etc/|/proc|\.\.) |\|id ?\; ?echo*\|)" \
        "phase:2,block,status:403,capture,t:none,t:urlDecodeUni,t:replaceNulls,t:compressWhitespace,t:lowercase,id:340014,rev:10,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE CMD injection',logdata:'%{TX.0}'"


# Rule 340018: 
#Generic command line attack filter
SecRule REQUEST_URI "\|.*;.*;.*\|" \
	"phase:2,block,status:403,capture,t:none,t:urlDecodeUni,id:340018,rev:10,severity:2,msg:'Atomicorp.com UNSUPPORTED DELAYED Rules: PARANOID MODE Generic command line attack filter',logdata:'%{TX.0}'"

# Rule 340029: script, perl, etc. code 
SecRule REQUEST_URI|ARGS "; ?(?:cat|ls|perl|uname|pwd|cp|kill|echo|tclsh8?|cpp|python|chown|rm|kill|ping|rsync|rdiff-backup|ssh|scp|wget|curl|links|g\+\+|ch(?:grp|own)|passwd|bash|telnet) " \
