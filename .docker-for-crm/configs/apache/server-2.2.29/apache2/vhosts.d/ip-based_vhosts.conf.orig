<VirtualHost 85.10.203.24:443>
 ServerName web6.order.hoststar.ch
 DocumentRoot /home/www/web6/html
  #SuexecUserGroup web6 web6
 ScriptAlias /cgi-bin/ /home/www/web6/html/cgi-bin/
 php_admin_value open_basedir /home/www/web6/html/:/home/www/web6/phptmp/:/home/www/web6/files/:/home/www/web6/atd/
 php_admin_value file_uploads 1
 php_admin_value upload_tmp_dir /home/www/web6/phptmp/
 <IfModule mod_ssl.c>
  SSLEngine on
  SSLCertificateKeyFile /etc/apache2/ssl.key/admin.key
  SSLCertificateFile /etc/apache2/ssl.crt/admin.crt
  SetEnvIf User-Agent ".*MSIE.*" \
  nokeepalive ssl-unclean-shutdown \
        downgrade-1.0 force-response-1.0
SSLCertificateChainFile /etc/apache2/ssl.crt/ca-admin.crt
  <Files ~ "\.(cgi|shtml|phtml|php3?)$">
   SSLOptions +StdEnvVars
  </Files>
  <Directory "/home/www/web6/html/cgi-bin">
   SSLOptions +StdEnvVars
  </Directory>
 </IfModule>

 php_admin_flag register_globals on
 php_admin_flag magic_quotes_gpc on
 php_admin_flag safe_mode off
 php_admin_value safe_mode_exec_dir /home/www/empty/
 php_admin_flag allow_call_time_pass_reference on
 php_admin_value memory_limit 64M
 php_admin_value upload_max_filesize 8M
 php_admin_value open_basedir /home/www/web6/:/usr/bin:/usr/local/saferpay:/home/www/empty:/tmp
 php_admin_value session.save_path /home/www/web6/phptmp
 php_admin_value max_execution_time 300

 <Directory /home/www/web6/html>
  Options +FollowSymLinks +SymLinksIfOwnerMatch
 </Directory>
</VirtualHost>
